// The look-ahead benchmark's doomed-recursion domain: the first method
// recurses forever (`Spiral`) before an impossible tail task; the second
// method plans fine. With the look-ahead the recursion is never entered;
// without it the planner burns its whole step budget (the default 100, i.e.
// the realistic setting) and returns a partial plan.
schema {
    version: 0.1.0
}

compound_task "Act" {
    method "doomed" {
        subtasks: [Prime, Spiral, Impossible]
    }
    method "safe" {
        subtasks: [Safe]
    }
}

compound_task "Spiral" {
    method "only" {
        subtasks: [Spiral]
    }
}

primitive_task "Prime" {
    operator: NoopOperator
    effects: [noise = true]
}

primitive_task "Impossible" {
    operator: NoopOperator
    preconditions: [gold > 100]
}

primitive_task "Safe" {
    operator: NoopOperator
    effects: [gold = 1]
}
