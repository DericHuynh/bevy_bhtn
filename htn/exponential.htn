// The look-ahead benchmark's exponential-backtracking domain: a doomed method
// whose chain of 12 binary-choice gates never touches `gold`, followed by a
// task requiring `gold > 1000`. With the look-ahead sweep the doomed method is
// refuted in one pass; without it, plain MTR backtracking must enumerate all
// 2^12 gate combinations before abandoning the method (the planner's sanity
// limit is raised by the bench so the blowup is visible rather than capped).
// The second root method succeeds directly.
schema {
    version: 0.1.0
}

compound_task "Root" {
    method "doomed" {
        subtasks: [
            Gate0, Gate1, Gate2, Gate3, Gate4, Gate5,
            Gate6, Gate7, Gate8, Gate9, Gate10, Gate11,
            Final,
        ]
    }
    method "direct" {
        subtasks: [Strike, Final]
    }
}

compound_task "Gate0" {
    method "a" {
        subtasks: [JunkA0]
    }
    method "b" {
        subtasks: [JunkB0]
    }
}

primitive_task "JunkA0" {
    operator: NoopOperator
    effects: [noise = true]
}

primitive_task "JunkB0" {
    operator: NoopOperator
    effects: [noise = false]
}

compound_task "Gate1" {
    method "a" {
        subtasks: [JunkA1]
    }
    method "b" {
        subtasks: [JunkB1]
    }
}

primitive_task "JunkA1" {
    operator: NoopOperator
    effects: [noise = true]
}

primitive_task "JunkB1" {
    operator: NoopOperator
    effects: [noise = false]
}

